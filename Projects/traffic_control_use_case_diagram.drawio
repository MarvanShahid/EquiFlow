        </mxCell>
        <mxCell id="uc2" value="Run simulation" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="260" y="195" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="uc3" value="Inspect ambulance detection" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="260" y="290" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="uc4" value="Observe priority / preemption" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="260" y="385" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="uc5" value="Observe recovery" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="260" y="480" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="uc6" value="Export metrics and logs" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="260" y="575" width="300" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="operator" value="Operator" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="40" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ext1" value="Road network,&lt;br&gt;demand files,&lt;br&gt;controller config" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="720" y="110" width="40" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ext2" value="Video stream /&lt;br&gt;simulated emergency&lt;br&gt;vehicle state" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="720" y="290" width="40" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="e1" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="operator" target="uc1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="operator" target="uc2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="operator" target="uc3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="operator" target="uc4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="operator" target="uc5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="operator" target="uc6"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e7" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="ext1" target="uc1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="ext2" target="uc2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="ext2" target="uc3"><mxGeometry relative="1" as="geometry"/></mxCell>
