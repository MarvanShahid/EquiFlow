<mxfile host="app.diagrams.net">
  <diagram name="Use Case Diagram" id="uc-traffic-1">
    <mxGraphModel dx="1100" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="boundary" value="AI-based traffic control system" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="200" y="40" width="420" height="640" as="geometry"/>
        </mxCell>

        <mxCell id="uc1" value="Configure scenario" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
